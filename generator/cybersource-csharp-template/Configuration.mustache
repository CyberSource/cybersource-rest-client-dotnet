        [Obsolete("This method is deprecated and will be removed in the next major release. This authentication mechanism is not supported.")]
        public void AddApiKeyPrefix(string key, string value)
        {
            throw new NotSupportedException();
        }

        /// <summary>
        /// Gets or sets the web proxy for the request.
        /// </summary>
        /// <param name="proxy">The proxy object.</param>
        [Obsolete("This method is deprecated and will be removed in the next major release. Please use the {{packageName}}.Client.IMerchantNetworkSettings.AddWebProxy method instead.")]
        public void AddWebProxy(WebProxy proxy)
        {
            MerchantNetworkSettings.AddWebProxy(proxy);
        }
        #endregion Legacy Public Methods

        #region Mutation Methods

        void IMutableConfiguration.AddMerchantCredentialSettings(IMerchantCredentialSettings merchantCredentialSettings)
        {
            MerchantCredentialSettings = merchantCredentialSettings;
        }

        void IMutableConfiguration.AddMLESettings(IMerchantMLESettings merchantMLESettings)
        {
            MerchantMLESettings = merchantMLESettings;
        }
        #endregion Mutation Methods
    }
}
